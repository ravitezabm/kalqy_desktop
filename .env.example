# Base URL for the Kalqy backend API (used by src/services/*).
VITE_API_BASE_URL=https://api.kalqy.in

# Public deep-link base the mobile app scans to join an onboarding session.
VITE_MOBILE_CONNECT_BASE_URL=https://app.kalqy.in/onboarding/connect

# Where the Settings screen's "Open Parent App" QR code points — a static
# app-store/deep-link URL, unrelated to the onboarding session QR above.
VITE_PARENT_APP_URL=https://app.kalqy.in/parent
